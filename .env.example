# Firebase Client SDK Configuration
# Obtain these values from your Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="siteflow-production.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="siteflow-production"
VITE_FIREBASE_STORAGE_BUCKET="siteflow-production.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Optional: Specific Firestore Database ID (leave empty or '(default)')
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Optional: Google Maps Platform API Key (for external maps / geocoding if enabled)
VITE_GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKeyPlaceholder"

# Application Host URL (Injected by runtime or deployment)
APP_URL="https://ais-dev-gutphsh2vgeu35dq5bq4n3-873313351535.us-east1.run.app"
