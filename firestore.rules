rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userCompanyId() {
      return userExists() ? userDoc().companyId : '';
    }

    function userRole() {
      return userExists() ? userDoc().role : '';
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn() && userCompanyId() == companyId;
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return isSignedIn() && (userRole() == 'ADMIN' || userRole() == 'SUPER_ADMIN');
    }

    function isProjectManager() {
      return isSignedIn() && (userRole() == 'PROJECT_MANAGER' || isAdmin());
    }

    function isSupervisor() {
      return isSignedIn() && (userRole() == 'SUPERVISOR' || isProjectManager());
    }

    function isAttendanceManager() {
      return isSignedIn() && (userRole() in ['SUPER_ADMIN', 'ADMIN', 'PROJECT_MANAGER', 'SUPERVISOR', 'HR']);
    }

    // Company Validation
    function isValidCompany(data) {
      return data.keys().hasAll(['companyId', 'name', 'email', 'status', 'createdAt', 'updatedAt', 'createdBy']) &&
             data.companyId is string && data.companyId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 255 &&
             data.status in ['active', 'suspended', 'trial', 'inactive'] &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    // P0-2 & P0-3: Time Entry Relational & Entity Validation
    function isValidTimeEntryCreation(companyId, data) {
      return (
        // Identity consistency: User exists and belongs to this company
        exists(/databases/$(database)/documents/users/$(data.userId)) &&
        get(/databases/$(database)/documents/users/$(data.userId)).data.companyId == companyId &&
        // Employee exists in this company
        exists(/databases/$(database)/documents/companies/$(companyId)/employees/$(data.employeeId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)/employees/$(data.employeeId)).data.companyId == companyId &&
        // Employee record userId matches data.userId
        get(/databases/$(database)/documents/companies/$(companyId)/employees/$(data.employeeId)).data.userId == data.userId &&
        // Project exists in this company
        exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(data.projectId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)/projects/$(data.projectId)).data.companyId == companyId &&
        // Job site exists in this company
        exists(/databases/$(database)/documents/companies/$(companyId)/jobSites/$(data.jobSiteId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)/jobSites/$(data.jobSiteId)).data.companyId == companyId &&
        // Relational integrity: JobSite.projectId == data.projectId
        get(/databases/$(database)/documents/companies/$(companyId)/jobSites/$(data.jobSiteId)).data.projectId == data.projectId
      );
    }

    // P0-2 & P0-3 (Phase 0.2): Shift Relational, Project, JobSite, and Employee / User Integrity
    function isValidShiftData(companyId, data) {
      return (
        // Project exists in this company
        exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(data.projectId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)/projects/$(data.projectId)).data.companyId == companyId &&
        // Job site exists in this company and belongs to the specified project
        exists(/databases/$(database)/documents/companies/$(companyId)/jobSites/$(data.jobSiteId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)/jobSites/$(data.jobSiteId)).data.companyId == companyId &&
        get(/databases/$(database)/documents/companies/$(companyId)/jobSites/$(data.jobSiteId)).data.projectId == data.projectId &&
        // Employee exists in this company
        exists(/databases/$(database)/documents/companies/$(companyId)/employees/$(data.employeeId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)/employees/$(data.employeeId)).data.companyId == companyId &&
        // When assignedUserId is present, validate user existence, company membership, and employee.userId matching
        (
          !('assignedUserId' in data) ||
          data.assignedUserId == null ||
          data.assignedUserId == '' ||
          (
            exists(/databases/$(database)/documents/users/$(data.assignedUserId)) &&
            get(/databases/$(database)/documents/users/$(data.assignedUserId)).data.companyId == companyId &&
            get(/databases/$(database)/documents/companies/$(companyId)/employees/$(data.employeeId)).data.userId == data.assignedUserId
          )
        )
      );
    }

    // Companies Collection
    match /companies/{companyId} {
      // Members can read their own company, or creator during onboarding
      allow get: if isSignedIn() && (isMemberOfCompany(companyId) || request.auth.uid == resource.data.createdBy);
      
      // Onboarding: authenticated user creating new company
      allow create: if isSignedIn() &&
                    isValidId(companyId) &&
                    request.resource.data.companyId == companyId &&
                    request.resource.data.createdBy == request.auth.uid &&
                    isValidCompany(request.resource.data);

      // Only SUPER_ADMIN or ADMIN can update company profile, never change immutable IDs
      allow update: if isSignedIn() &&
                    isMemberOfCompany(companyId) &&
                    isAdmin() &&
                    isValidCompany(request.resource.data) &&
                    request.resource.data.companyId == resource.data.companyId &&
                    request.resource.data.createdBy == resource.data.createdBy &&
                    request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false; // Deleting companies directly from client is forbidden

      // Employees Subcollection
      match /employees/{employeeId} {
        // Employees can read their own record; Admins can read all company employees
        allow get: if isSignedIn() && isMemberOfCompany(companyId) &&
                   (isAdmin() || resource.data.userId == request.auth.uid);

        allow list: if isSignedIn() && isMemberOfCompany(companyId) && isAdmin();

        // P0: Allowed employee creation paths ONLY:
        // Path A: Initial company onboarding (creator creating initial SUPER_ADMIN employee)
        // Path B: Authorized Admin / SuperAdmin creating workforce record
        // Path C: Invited employee accepting valid pending invitation
        allow create: if isSignedIn() &&
                      isValidId(employeeId) &&
                      request.resource.data.companyId == companyId &&
                      request.resource.data.employeeId == employeeId &&
                      (
                        // Path A: Creator initializing company
                        (
                          request.resource.data.userId == request.auth.uid &&
                          (
                            (exists(/databases/$(database)/documents/companies/$(companyId)) && get(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == request.auth.uid) ||
                            getAfter(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == request.auth.uid
                          )
                        ) ||
                        // Path B: Admin in company creating employee (cannot grant SUPER_ADMIN unless actor is SUPER_ADMIN)
                        (
                          isMemberOfCompany(companyId) &&
                          isAdmin() &&
                          (request.resource.data.role != 'SUPER_ADMIN' || isSuperAdmin())
                        ) ||
                        // Path C: Authenticated user accepting their valid, pending invitation
                        (
                          request.resource.data.userId == request.auth.uid &&
                          request.resource.data.invitationId is string &&
                          exists(/databases/$(database)/documents/companies/$(companyId)/invitations/$(request.resource.data.invitationId)) &&
                          get(/databases/$(database)/documents/companies/$(companyId)/invitations/$(request.resource.data.invitationId)).data.email == request.auth.token.email &&
                          get(/databases/$(database)/documents/companies/$(companyId)/invitations/$(request.resource.data.invitationId)).data.status == 'pending' &&
                          ('expiresAt' in get(/databases/$(database)/documents/companies/$(companyId)/invitations/$(request.resource.data.invitationId)).data) &&
                          get(/databases/$(database)/documents/companies/$(companyId)/invitations/$(request.resource.data.invitationId)).data.expiresAt > request.time &&
                          request.resource.data.role == get(/databases/$(database)/documents/companies/$(companyId)/invitations/$(request.resource.data.invitationId)).data.role
                        )
                      );

        // P0: Strict field-level authorization on updates
        // Immutable fields: employeeId, companyId, userId, createdAt
        allow update: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      request.resource.data.companyId == resource.data.companyId &&
                      request.resource.data.employeeId == resource.data.employeeId &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      (
                        // Path 1: Employee updating their own non-sensitive contact fields
                        (
                          resource.data.userId == request.auth.uid &&
                          request.resource.data.role == resource.data.role &&
                          request.resource.data.status == resource.data.status &&
                          request.resource.data.employeeNumber == resource.data.employeeNumber &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'address', 'city', 'emergencyContact', 'updatedAt', 'profilePhotoUrl'])
                        ) ||
                        // Path 2: Admin updating employee (P0-5: cannot escalate or touch SUPER_ADMIN unless actor is SUPER_ADMIN)
                        (
                          isAdmin() &&
                          (resource.data.role != 'SUPER_ADMIN' || isSuperAdmin()) &&
                          (request.resource.data.role != 'SUPER_ADMIN' || isSuperAdmin())
                        )
                      );

        allow delete: if false; // Soft-delete / status deactivation enforced
      }

      // Invitations Subcollection
      match /invitations/{invitationId} {
        // Admins can view all company invitations; invited users can read their own invitation
        allow get: if isSignedIn() && (
          (isMemberOfCompany(companyId) && isAdmin()) ||
          (resource.data.email == request.auth.token.email)
        );

        allow list: if isSignedIn() && isMemberOfCompany(companyId) && isAdmin();
        
        allow create: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      isAdmin() &&
                      isValidId(invitationId) &&
                      request.resource.data.companyId == companyId &&
                      request.resource.data.invitationId == invitationId &&
                      ('expiresAt' in request.resource.data) &&
                      request.resource.data.expiresAt > request.time &&
                      (request.resource.data.role != 'SUPER_ADMIN' || isSuperAdmin());

        // P0-1 (Phase 0.2): Tightened update rule - strictly isolated acceptance vs revocation paths
        allow update: if isSignedIn() && (
          // Path 1: Invited user accepting valid, unexpired pending invitation
          (
            resource.data.status == 'pending' &&
            ('expiresAt' in resource.data) &&
            resource.data.expiresAt > request.time &&
            resource.data.email == request.auth.token.email &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.acceptedByUserId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'acceptedAt',
              'acceptedByUserId'
            ])
          ) ||
          // Path 2: Administrator / SuperAdmin revoking a pending invitation (strictly field-restricted)
          (
            isMemberOfCompany(companyId) &&
            isAdmin() &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'revoked' &&
            request.resource.data.companyId == resource.data.companyId &&
            request.resource.data.invitationId == resource.data.invitationId &&
            request.resource.data.email == resource.data.email &&
            request.resource.data.invitedBy == resource.data.invitedBy &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'revokedAt',
              'revokedBy'
            ])
          )
        );

        allow delete: if false; // Soft-delete / revocation enforced; no client deletion of protected records
      }

      // Audit Logs Subcollection (Strictly Append-Only & Immutable)
      match /auditLogs/{auditId} {
        // Only Admins / SuperAdmins can read audit trail
        allow read: if isSignedIn() && isMemberOfCompany(companyId) && isAdmin();
        
        // Append-only validation: actorUserId must equal authenticated UID
        allow create: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      isValidId(auditId) &&
                      request.resource.data.companyId == companyId &&
                      request.resource.data.auditId == auditId &&
                      request.resource.data.actorUserId == request.auth.uid &&
                      request.resource.data.action in [
                        'USER_REGISTERED', 'USER_LOGGED_IN', 'USER_LOGGED_OUT',
                        'PASSWORD_RESET_REQUESTED', 'COMPANY_CREATED', 'COMPANY_SETTINGS_UPDATED',
                        'EMPLOYEE_CREATED', 'EMPLOYEE_UPDATED', 'EMPLOYEE_STATUS_CHANGED',
                        'ROLE_CHANGED', 'USER_STATUS_CHANGED', 'PERMISSION_CHANGED',
                        'INVITATION_CREATED', 'INVITATION_ACCEPTED', 'INVITATION_REVOKED',
                        'PROJECT_CREATED', 'PROJECT_UPDATED', 'JOB_SITE_CREATED',
                        'JOB_SITE_UPDATED', 'SHIFT_CREATED', 'SHIFT_UPDATED',
                        'CLOCK_IN', 'CLOCK_OUT', 'BREAK_START', 'BREAK_END',
                        'ATTENDANCE_EDITED', 'SUPERVISOR_OVERRIDE', 'GEOFENCE_FAILED'
                      ] &&
                      request.resource.data.resourceType in [
                        'company', 'user', 'employee', 'invitation', 'settings',
                        'project', 'jobSite', 'shift', 'timeEntry'
                      ];

        allow update, delete: if false; // Audit logs can NEVER be updated or deleted
      }

      // Projects Subcollection
      match /projects/{projectId} {
        allow read: if isSignedIn() && isMemberOfCompany(companyId);
        
        allow create: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      isProjectManager() &&
                      isValidId(projectId) &&
                      request.resource.data.companyId == companyId &&
                      request.resource.data.projectId == projectId;

        allow update: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      isProjectManager() &&
                      request.resource.data.companyId == resource.data.companyId &&
                      request.resource.data.projectId == resource.data.projectId &&
                      request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if false;
      }

      // Job Sites Subcollection
      match /jobSites/{jobSiteId} {
        allow read: if isSignedIn() && isMemberOfCompany(companyId);
        
        // P0-3: Project must exist in this company
        allow create: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      isProjectManager() &&
                      isValidId(jobSiteId) &&
                      request.resource.data.companyId == companyId &&
                      request.resource.data.jobSiteId == jobSiteId &&
                      exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(request.resource.data.projectId)) &&
                      get(/databases/$(database)/documents/companies/$(companyId)/projects/$(request.resource.data.projectId)).data.companyId == companyId;

        // P0-3: Project reference must remain consistent with company
        allow update: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      isProjectManager() &&
                      request.resource.data.companyId == resource.data.companyId &&
                      request.resource.data.jobSiteId == resource.data.jobSiteId &&
                      request.resource.data.projectId == resource.data.projectId &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      exists(/databases/$(database)/documents/companies/$(companyId)/projects/$(request.resource.data.projectId)) &&
                      get(/databases/$(database)/documents/companies/$(companyId)/projects/$(request.resource.data.projectId)).data.companyId == companyId;

        allow delete: if false;
      }

      // Shifts Subcollection
      match /shifts/{shiftId} {
        // Workers can only read their assigned shifts; Supervisors and Managers read all
        allow get: if isSignedIn() && isMemberOfCompany(companyId) &&
                   (isSupervisor() || (('assignedUserId' in resource.data) && resource.data.assignedUserId == request.auth.uid));
        
        allow list: if isSignedIn() && isMemberOfCompany(companyId) &&
                    (isSupervisor() || (('assignedUserId' in resource.data) && resource.data.assignedUserId == request.auth.uid));
        
        // P0-2 & P0-3 (Phase 0.2): Project, JobSite, and Employee + assignedUserId integrity
        allow create: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      isSupervisor() &&
                      isValidId(shiftId) &&
                      request.resource.data.companyId == companyId &&
                      request.resource.data.shiftId == shiftId &&
                      isValidShiftData(companyId, request.resource.data);

        allow update: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      isSupervisor() &&
                      request.resource.data.companyId == resource.data.companyId &&
                      request.resource.data.shiftId == resource.data.shiftId &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      isValidShiftData(companyId, request.resource.data);

        allow delete: if false;
      }

      // Time Entries Subcollection (Authoritative Attendance)
      match /timeEntries/{timeEntryId} {
        // P0: Workers read ONLY their own records; Supervisors and Admins read company records
        allow get: if isSignedIn() && isMemberOfCompany(companyId) &&
                   (resource.data.userId == request.auth.uid || isAttendanceManager());

        // P0: List query condition - NO request.auth.uid != null blanket allowed
        allow list: if isSignedIn() && isMemberOfCompany(companyId) &&
                    (isAttendanceManager() || resource.data.userId == request.auth.uid);

        // P0-2 & P0-3: Workers clock in for themselves only, or supervisor override; Relational integrity enforced
        allow create: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      isValidId(timeEntryId) &&
                      request.resource.data.companyId == companyId &&
                      request.resource.data.timeEntryId == timeEntryId &&
                      (request.resource.data.userId == request.auth.uid || isSupervisor()) &&
                      isValidTimeEntryCreation(companyId, request.resource.data);

        // P0-4: Strict field restrictions on both worker and supervisor updates; Immutable identity fields
        allow update: if isSignedIn() &&
                      isMemberOfCompany(companyId) &&
                      request.resource.data.companyId == resource.data.companyId &&
                      request.resource.data.timeEntryId == resource.data.timeEntryId &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.employeeId == resource.data.employeeId &&
                      request.resource.data.projectId == resource.data.projectId &&
                      request.resource.data.jobSiteId == resource.data.jobSiteId &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      (
                        // Worker updating their own active entry
                        (
                          resource.data.userId == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'status', 'breaks', 'totalBreakMinutes', 'totalWorkMinutes',
                            'clockOutTime', 'clockOutServerTimestamp', 'clockOutLocation', 'notes', 'updatedAt'
                          ])
                        ) ||
                        // Supervisor correcting operational attendance fields
                        (
                          isSupervisor() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'clockInTime', 'clockInServerTimestamp', 'clockInLocation',
                            'clockOutTime', 'clockOutServerTimestamp', 'clockOutLocation',
                            'breaks', 'totalBreakMinutes', 'totalWorkMinutes',
                            'status', 'notes',
                            'isSupervisorOverride', 'overrideReason', 'overriddenBy',
                            'updatedAt'
                          ])
                        )
                      );

        allow delete: if false;
      }
    }

    // Users Collection (Indexed by Firebase Auth UID)
    match /users/{userId} {
      // User can read their own profile; Admins of the same company can read profiles of their employees
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        (isAdmin() && resource.data.companyId == userCompanyId())
      );

      // Admins can list users strictly scoped to their company
      allow list: if isSignedIn() && isAdmin() && resource.data.companyId == userCompanyId();

      // Onboarding create: user registers profile with their own uid
      allow create: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(userId) &&
                    request.resource.data.uid == userId &&
                    request.resource.data.email == request.auth.token.email &&
                    // Forbid normal user self-assigning SUPER_ADMIN unless they are creating the new company
                    (
                      request.resource.data.role != 'SUPER_ADMIN' ||
                      !exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)) ||
                      getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.createdBy == request.auth.uid
                    );

      // P0-5 & TEST 18: User and Admin update rules with SUPER_ADMIN protection
      allow update: if isSignedIn() && (
        // Branch 1: User updating own profile (can only change profile fields, never role, status, or companyId)
        (
          request.auth.uid == userId &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'lastName', 'displayName', 'phone', 'photoUrl', 'updatedAt', 'lastLoginAt'
          ])
        ) ||
        // Branch 2: Admin updating user record
        (
          isAdmin() &&
          resource.data.companyId == userCompanyId() &&
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          // P0-5: If target is SUPER_ADMIN, ONLY a SUPER_ADMIN can modify it
          (resource.data.role != 'SUPER_ADMIN' || isSuperAdmin()) &&
          // Non-SUPER_ADMIN cannot grant SUPER_ADMIN
          (request.resource.data.role != 'SUPER_ADMIN' || isSuperAdmin()) &&
          // Allowed admin updates
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'status', 'firstName', 'lastName', 'displayName', 'phone', 'photoUrl', 'updatedAt'
          ])
        )
      );

      allow delete: if false;
    }

    // Collection Group Query: Authenticated user querying their pending invitations
    match /{path=**}/invitations/{invitationId} {
      allow read: if isSignedIn() && resource.data.email == request.auth.token.email;
    }
  }
}
