rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default Deny All: Production Cloud Storage is default-deny.
    // ARCHITECTURE CONSTRAINT (Phase 0.4B):
    // SITEFLOW operates on a named Firestore database ('ai-studio-siteflow-8e674b08-0f8a-4b58-a60a-896eedd3df21').
    // Firebase Storage Security Rules only support querying the DEFAULT database ('/databases/(default)/...').
    // Because client-only architecture cannot securely maintain a server-side authorization mirror in '(default)',
    // and public access ('allow read: if true;') or relaxed unverified rules are strictly forbidden,
    // all Cloud Storage reads and writes remain denied (default-deny) until server-authoritative
    // authorization synchronization is established.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

